DOMAIN=mycloud.cysmk.online
ADMIN_INITIAL_USERNAME=kdsinn
ADMIN_INITIAL_PASSWORD=change_this_secure_password_in_production

# MySQL Settings
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=mycloud_db
MYSQL_USER=mycloud_user
MYSQL_PASSWORD=change_this_mysql_password

# MongoDB Settings
MONGODB_DATABASE=mycloud_doc_db
MONGODB_USER=mycloud_mongo_user
MONGODB_PASSWORD=change_this_mongo_password

# Redis Settings
REDIS_PASSWORD=change_this_redis_password

# Application Secrets
SESSION_SECRET=generate_a_long_random_string_here_for_sessions
JWT_SECRET=generate_a_long_random_string_here_for_jwt

# Storage Path (Absolute path on the host)
STORAGE_PATH=/opt/mycloud/storage
